{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "BiliDownloader 主窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:tray:default",
    "shell:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:scope-appdata",
    "fs:scope-download",
    "fs:scope-video",
    "fs:scope-audio",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "store:default"
  ]
}