{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliDownloader",
  "version": "0.1.0",
  "identifier": "com.itharron.bili-downloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BiliDownloader - B 站视频下载器",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "BiliDownloader - B 站视频下载器"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.bilibili.com https://*.bilibili.com https://*.hdslb.com https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": {
      "binaries/yt-dlp.exe": "yt-dlp.exe"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/itharron/bili_downloader/releases/latest/download/latest.json"
      ],
      "pubkey": "CHANGEME_UPDATE_PUBLIC_KEY"
    }
  }
}